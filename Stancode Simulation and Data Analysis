inits_opt <- function(chain_id = 1) {
  set.seed(123 + chain_id)   # ensures different chains get different seeds
  
  K <- ncol(data.unit.mixed$X)
  M <- max(data.unit.mixed$id)
  
  list(
    beta    = rnorm(K, 0, 0.001),        # small random around 0
    sigma_b = runif(2, 0.05, 0.15),      # small positive values
    z_b     = matrix(rnorm(2 * M, 0, 0.001), nrow = 2, ncol = M),  # near 0
    L_b     = diag(2),                    # identity correlation
    alpha   = runif(1, 0.5, 2)          # positive, safe range
  )
}






