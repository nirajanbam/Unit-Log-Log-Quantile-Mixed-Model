inits3 <- function(chain_id = 1) {
  set.seed(123 + chain_id)
  
  K <- ncol(data.unit.mixed$X)
  M <- max(data.unit.mixed$id)
  
  list(
    beta    = rep(0, K),                  # start at 0
    sigma_b = rep(0.1, 2),                # very small positive values
    z_b     = matrix(0, 2, M),            # start at 0
    L_b     = diag(2),                     # identity
    alpha   = runif(1, 0.5, 1.8)                             # safe positive value
  )
}

