library(brms)
model_data_final <- model_data_final %>%
  rename(
    Country = "country",
    Year = "year_c",
    PopulationMil = "Population_mil",
    LogGDP = "GDP_log",
    UrbanPG = "Urban_pop_growth",
    RenewableE = "Renewable_share",
    GHG="Value"
  )

View(model_data_final)

fit <- brm(
  formula = log(GHG) ~ Year + PopulationMil+ LogGDP+
    UrbanPG + RenewableE +
    (1 + Year | Country),
  data = model_data_final,
  family = gaussian(),
  chains = 4,
  cores = 4,
  iter = 8000,
  warmup = 4000,
  control = list(adapt_delta = 0.95, max_treedepth = 15)
)

####Fixed Effect###
fixef_table <- summary(fit)$fixed
fixef_table <- round(fixef_table, 4)
fixef_table <- as.data.frame(fixef_table)
fixef_table$Parameter <- rownames(fixef_table)
fixef_table <- fixef_table[, c("Parameter", "Estimate", "Est.Error", "l-95% CI", "u-95% CI", "Rhat", "Bulk_ESS", "Tail_ESS")]
fixef_table
###Random Effect###
ranef_table <- summary(fit)$random$Country  # Replace 'country' with your grouping factor
ranef_table <- round(ranef_table, 4)
ranef_table$Parameter <- rownames(ranef_table)
ranef_table <- ranef_table[, c("Parameter", "Estimate", "Est.Error", "l-95% CI", "u-95% CI", "Rhat", "Bulk_ESS", "Tail_ESS")]
ranef_table
###SD###
sigma_table <- summary(fit)$spec_pars
sigma_table <- round(sigma_table, 4)
sigma_table$Parameter <- rownames(sigma_table)
sigma_table <- sigma_table[, c("Parameter", "Estimate", "Est.Error", "l-95% CI", "u-95% CI", "Rhat", "Bulk_ESS", "Tail_ESS")]
sigma_table

full_table <- rbind(fixef_table,ranef_table, sigma_table)
full_table

