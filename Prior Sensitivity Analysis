# Define South Asian countries
south_asia <- c("World",
                "India", "Pakistan", "Bangladesh", "Nepal", "Sri Lanka", 
                "Maldives", "Afghanistan")



# Filter South Asian countries
sa_data <- data %>%
  filter(Country %in% south_asia)

# Identify year columns automatically (starts with 19xx or 20xx)
year_cols <- names(sa_data)[grepl("^19|^20", names(sa_data))]

# Convert all year columns to numeric (safe for character or double)
sa_data <- sa_data %>%
  mutate(across(all_of(year_cols), as.numeric))

# Reshape to long format
sa_long <- sa_data %>%
  mutate(across(all_of(year_cols), as.numeric)) %>%   # ensure numeric
  pivot_longer(
    cols = all_of(year_cols),
    names_to = "Year",
    values_to = "Value"
  ) %>%
  mutate(
    Year = as.integer(Year),
    Year_c = Year - 2000     # center year at 1990
  ) %>%
  filter(Year >= 2000 & Year <= 2022) %>%  # keep only 2000-2022
  dplyr::select(ISO, Country, Sector, Gas, Unit, Year, Year_c, Value)



# make sure Year is numeric
sa_long <- sa_long %>%
  mutate(Year = as.numeric(Year))

# Plot emissions over time

asia_data <- sa_long %>%
  dplyr::filter(Country %in% south_asia)

# Separate World and country values
world_data <- asia_data %>%
  dplyr::filter(Country == "World") %>%
  dplyr::select(Year, World_Value = Value)

country_data <- asia_data %>%
  dplyr::filter(Country != "World")

# Join World values to country data by Year
ratio_data <- country_data %>%
  dplyr::left_join(world_data, by = "Year") %>%
  dplyr::mutate(Ratio = Value / World_Value) %>%
  dplyr::select(Country, Year, Value, World_Value, Ratio)

