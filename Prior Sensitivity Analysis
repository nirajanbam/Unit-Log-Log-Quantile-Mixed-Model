library(tidyr)
library(ggplot2)


# Function to extract posterior samples of fixed effect##
extract_post_fixed <- function(fit, prior_name){
  ex <- rstan::extract(fit)
  data.frame(
    beta1 = ex$beta[,1],
    beta2 = ex$beta[,2],
    beta3 = ex$beta[,3],
    beta4 = ex$beta[,4],
    beta5 = ex$beta[,5],
    beta6 = ex$beta[,6],
    Prior = prior_name
  )
}

###Function to extract random effect and shape parameters###
extract_post_random <- function(fit, prior_name){
  ex <- rstan::extract(fit)
  data.frame(
    sigma_b1 = ex$sigma_b[,1],
    sigma_b2 = ex$sigma_b[,2],
    rho12 = ex$Rho[,1,2],
    alpha = ex$alpha,
    Prior = prior_name
  )
}

# Extract from all five priors for fixed effect###
df1 <- extract_post_fixed(fit1, "Prior 1")
df2 <- extract_post_fixed(fit2, "Prior 2")
df3 <- extract_post_fixed(fit3, "Prior 3")
df4 <- extract_post_fixed(fit4, "Prior 4")
df5 <- extract_post_fixed(fit55, "Prior 5")

# Combine all fixed effects draws###
all_df_fixed <- bind_rows(df1,df2,df3,df4, df5)

# Convert to long format
plot_df_fixed <- all_df_fixed %>%
  pivot_longer(
    cols = -Prior,
    names_to = "Parameter",
    values_to = "Value"
  )

# Convert parameter names to math expressions##
plot_df_fixed$Parameter <- recode(
  plot_df_fixed$Parameter,
  beta1 = "beta[1]",
  beta2 = "beta[2]",
  beta3 = "beta[3]",
  beta4 = "beta[4]",
  beta5 = "beta[5]",
  beta6 = "beta[6]"
)

# Posterior comparison boxplots for fixed effects##
ggplot(plot_df_fixed, aes(x = Prior, y = Value)) +
  geom_boxplot() +
  facet_wrap(
    ~Parameter,
    scales = "free",
    labeller = label_parsed
  ) +
  theme_bw() +
  labs(
    title = "",
    x = "Prior Specification",
    y = "Posterior Estimates"
  )


# Extract from all five priors for random effects and shape parameter##
df12 <- extract_post_random(fit1, "Prior 1")
df22 <- extract_post_random(fit2, "Prior 2")
df32 <- extract_post_random(fit3, "Prior 3")
df42 <- extract_post_random(fit4, "Prior 4")
df52 <- extract_post_random(fit55, "Prior 5")

# Combine all
all_df_random <- bind_rows(df12,df22,df32,df42, df52)

# Convert to long format
plot_df_random <- all_df_random %>%
