# Quantile function (bounded distribution)
Q_custom <- function(p, alpha, mu, u) {
  if (alpha <= 0) stop("alpha must be > 0")
  if (mu <= 0 || mu >= 1) stop("mu must be in (0,1)")
  
  B <- -log(mu)
  denom_log <- log(1 - log(u))
  numer_log <- log(1 - log(p))
  frac <- numer_log / denom_log
  y <- exp(-B * (frac)^(1 / alpha))
}

#

# Random draw function
r_custom <- function(n, alpha, mu, u) {
  #p <- runif(n)
  p <- runif(n)
  Q_custom(p, alpha, mu, u)
}

# Simulation function
simulate_data <- function(n, M, beta_true, Sigma_b_true, alpha_true, u) {
  X <- cbind(1, rnorm(n), rnorm(n)) 
  id <- rep(1:M, length.out = n)
  b_mat <- mvrnorm(M, mu = c(0, 0), Sigma = Sigma_b_true)
  
  eta <- X %*% beta_true
  mu <- numeric(n)
  y <- numeric(n)
  
  for (i in 1:n) {
    rand_eff <- b_mat[id[i], 1] + b_mat[id[i], 2] * X[i, 3]
    mu[i] <- 1 / (1 + exp(-(eta[i] + rand_eff)))
    y[i] <- r_custom(1, alpha_true, mu[i], u)
  }
  
  list(X = X, y = y, id = id, mu = mu)
}
results <- data.frame()

stan_model <- stan_model(model_code = QULL_Model)

for (sim in 1:Nsim) {
  cat("Simulation", sim, "of", Nsim, "\n")
  
  # Simulate data including zero inflation (gamma_true added)
  data_sim <- simulate_data(n, M, beta_true, Sigma_b_true, alpha_true, u)
  stan_data <- list(
    n = n, M = M, y = data_sim$y, K = K, X = data_sim$X, id = data_sim$id,
    b0 = rep(0, K), B0 = diag(100, K), u = u
  )
  
  inits1 <- function() {
    list(
      beta    = rnorm(K, 0, 0.05),           # tighter around 0, less chance of extreme values
      sigma_b = runif(2, 0.05, 0.2),         # small positive values, avoids exact zero
      z_b     = matrix(rnorm(2 * M, 0, 0.05), nrow = 2, ncol = M), # small values
      L_b     = diag(2) + matrix(rnorm(4, 0, 0.01), nrow = 2), # slightly perturbed identity
      alpha   = runif(1, 0.5, 1.8)             # positive and away from extreme boundary
    )
  }
  
  warning_occurred <- FALSE
  
  fit <- tryCatch(
    withCallingHandlers(
      sampling(stan_model, data = stan_data, chains = 2, iter = 5000, init = inits1,
               control = list(adapt_delta = 0.999, max_treedepth = 18), refresh=0),
      warning = function(w) {
        message("⚠️  Warning in sim ", sim, ": ", conditionMessage(w))
        warning_occurred <<- TRUE
        invokeRestart("muffleWarning")
      }
    ),
    error = function(e) {
      message("❌  Error in sim ", sim, ": ", conditionMessage(e))
      NULL
    }
  )
  
  if (warning_occurred || is.null(fit)) {
    cat("⏩ Skipping simulation", sim, "due to warning or error\n")
    next
  }
  
  post_sum <- summary(fit)$summary
  # Extract beta estimates
  est_beta1 <- post_sum["beta[1]", "mean"]
  lci_beta1 <- post_sum["beta[1]", "2.5%"]
  uci_beta1 <- post_sum["beta[1]", "97.5%"]
  
  est_beta2 <- post_sum["beta[2]", "mean"]
  lci_beta2 <- post_sum["beta[2]", "2.5%"]
  uci_beta2 <- post_sum["beta[2]", "97.5%"]
  
  est_beta3 <- post_sum["beta[3]", "mean"]
  lci_beta3 <- post_sum["beta[3]", "2.5%"]
  uci_beta3 <- post_sum["beta[3]", "97.5%"]
  
  # Extract sigma_b estimates
  est_sigma1 <- post_sum["sigma_b[1]", "mean"]
  lci_sigma1 <- post_sum["sigma_b[1]", "2.5%"]
  uci_sigma1 <- post_sum["sigma_b[1]", "97.5%"]
  
  est_sigma2 <- post_sum["sigma_b[2]", "mean"]
  lci_sigma2 <- post_sum["sigma_b[2]", "2.5%"]
  uci_sigma2 <- post_sum["sigma_b[2]", "97.5%"]
  
  # Extract rho (correlation)
  est_rho <- post_sum["Rho[1,2]", "mean"]
  lci_rho <- post_sum["Rho[1,2]", "2.5%"]
  uci_rho <- post_sum["Rho[1,2]", "97.5%"]
  
  # Extract theta (shape)
  est_alpha <- post_sum["alpha", "mean"]
  lci_alpha <- post_sum["alpha", "2.5%"]
  uci_alpha<- post_sum["alpha", "97.5%"]
  
  # Append to results (make sure 'results' data frame exists before loop)
  results <- rbind(
    results,
    data.frame(
      sim = sim,
      beta1 = est_beta1, beta1_lci = lci_beta1, beta1_uci = uci_beta1,
      beta2 = est_beta2, beta2_lci = lci_beta2, beta2_uci = uci_beta2,
      beta3 = est_beta3, beta3_lci = lci_beta3, beta3_uci = uci_beta3,
      sigma1 = est_sigma1, sigma1_lci = lci_sigma1, sigma1_uci = uci_sigma1,
      sigma2 = est_sigma2, sigma2_lci = lci_sigma2, sigma2_uci = uci_sigma2,
      rho = est_rho, rho_lci = lci_rho, rho_uci = uci_rho,
      alpha = est_alpha, alpha_lci = lci_alpha, alpha_uci = uci_alpha
    )
  )
  
  if (sim %% 10 == 0) cat("Completed:", sim, "simulations\n")
}

